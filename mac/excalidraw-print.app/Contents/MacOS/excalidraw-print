#!/bin/bash
# Launcher for the excalidraw-print GUI. Resolves the project directory
# relative to this bundle, so it keeps working if the repo is moved
# (as long as this .app stays inside <repo>/mac/).

LOG_DIR="$HOME/Library/Logs"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/excalidraw-print.log" 2>&1
echo "=== launch $(date) pid=$$ ==="
set -x
set -e

SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
PORT="${PORT:-5173}"
NODE_BIN="/usr/local/bin/node"
[ -x "$NODE_BIN" ] || NODE_BIN="$(command -v node)"

cd "$PROJECT_DIR"

SERVER_PID=""
CHROME_PROFILE_DIR=""
cleanup() {
  local status=$?
  echo "[exit trap] status=$status server_pid=$SERVER_PID"
  [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null
  [ -n "$CHROME_PROFILE_DIR" ] && rm -rf "$CHROME_PROFILE_DIR"
  true
}
trap cleanup EXIT

if ! curl -s -o /dev/null "http://127.0.0.1:$PORT/defaults"; then
  "$NODE_BIN" build.mjs
  "$NODE_BIN" src/gui-server.mjs &
  SERVER_PID=$!
  echo "started server pid=$SERVER_PID"

  for _ in $(seq 1 30); do
    curl -s -o /dev/null "http://127.0.0.1:$PORT/defaults" && break
    sleep 0.3
  done
fi

# Prefer opening as a standalone, chrome-less app window (using the
# Chromium build Playwright already manages) instead of a regular browser
# tab; fall back to the system default browser if that's unavailable.
# --remote-debugging-port marks this as an automation-controlled instance
# (even though nothing connects to it), which is what keeps this
# "Chrome for Testing" build from showing its "not for regular use" banner.
CHROME_PATH="$("$NODE_BIN" -e "console.log(require('playwright').chromium.executablePath())" 2>/dev/null || true)"
echo "chrome path: $CHROME_PATH"

CHROME_PID=""
if [ -n "$CHROME_PATH" ] && [ -x "$CHROME_PATH" ]; then
  CHROME_PROFILE_DIR="$(mktemp -d)"
  "$CHROME_PATH" \
    --app="http://127.0.0.1:$PORT" \
    --window-size=760,700 \
    --user-data-dir="$CHROME_PROFILE_DIR" \
    --remote-debugging-port=0 \
    --no-first-run \
    --no-default-browser-check \
    >/dev/null 2>&1 &
  CHROME_PID=$!
  echo "started chrome app window pid=$CHROME_PID"
else
  open "http://127.0.0.1:$PORT"
  echo "opened default browser instead"
fi

if [ -n "$CHROME_PID" ]; then
  echo "waiting on chrome pid=$CHROME_PID"
  wait "$CHROME_PID"
  echo "chrome exited with $?"
elif [ -n "$SERVER_PID" ]; then
  echo "waiting on server pid=$SERVER_PID"
  wait "$SERVER_PID"
  echo "server exited with $?"
fi
